{
  "name": "agentics-diligence",
  "version": "1.1.0",
  "description": "Agentics Diligence Artifacts API and Documentation Generator",
  "main": "src/server.js",
  "bin": {
    "agentics-diligence": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node src/test-validation.js",
    "test:agents": "node src/test-agents.js",
    "cli": "node src/cli.js",
    "generate": "node src/cli.js generate",
    "inspect": "node src/cli.js inspect",
    "templates": "node src/cli.js templates",
    "synthesize": "npx ts-node synthesis/index.ts",
    "build:synthesis": "npx tsc -p synthesis/tsconfig.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@agentics/contracts": "file:./contracts",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
