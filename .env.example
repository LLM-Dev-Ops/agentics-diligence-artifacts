# agentics-diligence-artifacts Environment Configuration
# Copy this file to .env and fill in values for local development
# DO NOT commit .env files with actual secrets

# =============================================================================
# REQUIRED: Service Configuration
# =============================================================================

# Service identity
SERVICE_NAME=agentics-diligence
SERVICE_VERSION=1.0.0

# Runtime environment: dev | staging | prod
PLATFORM_ENV=dev

# Server port (Cloud Run sets this automatically)
PORT=8080

# =============================================================================
# REQUIRED: RuVector Service (Persistence Layer)
# =============================================================================

# RuVector service URL - ALL persistence goes through this service
# agentics-diligence NEVER connects directly to databases
RUVECTOR_SERVICE_URL=http://localhost:8081

# Authentication mechanism (choose one)
# Option 1: API Key
RUVECTOR_API_KEY=

# Option 2: Service Account (GCP)
# Uses Application Default Credentials when deployed to Cloud Run

# =============================================================================
# REQUIRED: Telemetry (LLM-Observatory)
# =============================================================================

# Telemetry endpoint for agent execution tracking
LLM_OBSERVATORY_URL=http://localhost:9090

# Enable/disable telemetry (true | false)
LLM_OBSERVATORY_ENABLED=true

# =============================================================================
# OPTIONAL: LLM Configuration (for Synthesis layer)
# =============================================================================

# OpenAI API key for synthesis LLM calls
OPENAI_API_KEY=

# Anthropic API key (alternative to OpenAI)
ANTHROPIC_API_KEY=

# Model override (defaults to gpt-4-turbo)
LLM_MODEL=

# =============================================================================
# OPTIONAL: Google Cloud Configuration
# =============================================================================

# GCP Project ID
GOOGLE_CLOUD_PROJECT=agentics-dev

# GCP Region
GOOGLE_CLOUD_REGION=us-central1

# Service Account email (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =============================================================================
# OPTIONAL: Development Configuration
# =============================================================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Enable contract validation (always true in production)
ENABLE_CONTRACT_VALIDATION=true
