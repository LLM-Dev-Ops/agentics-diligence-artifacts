{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.io/contracts/documentation/v1/decision-event.schema.json",
  "title": "DocumentationDecisionEvent",
  "description": "Canonical schema for documentation generation DecisionEvents. The Documentation Generator Agent emits exactly ONE DecisionEvent per invocation.",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "const": "documentation-generator-agent",
      "description": "Fixed identifier for the Documentation Generator Agent"
    },
    "agent_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9]+)?$",
      "description": "Semantic version of the agent (e.g., '1.0.0')"
    },
    "decision_type": {
      "type": "string",
      "const": "documentation_generation",
      "description": "Fixed classification for documentation generation events"
    },
    "inputs_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of canonical input for deduplication and audit"
    },
    "outputs": {
      "type": "object",
      "description": "Documentation generation outputs",
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the generated artifact"
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "diligence_report",
            "executive_summary",
            "technical_assessment",
            "risk_report",
            "compliance_report",
            "audit_package",
            "governance_memo",
            "investment_memo",
            "architecture_overview",
            "decision_log"
          ],
          "description": "Type of documentation artifact generated"
        },
        "format": {
          "type": "string",
          "enum": ["markdown", "json", "html", "pdf_metadata"],
          "description": "Output format of the generated artifact"
        },
        "sections_generated": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of sections included in the artifact"
        },
        "source_events_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of source DecisionEvents consumed"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Approximate word count of the generated artifact"
        },
        "storage_ref": {
          "type": "string",
          "description": "Reference to stored artifact in ruvector-service"
        }
      },
      "required": ["artifact_id", "artifact_type", "format", "sections_generated", "source_events_count"],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Documentation completeness/coverage certainty (0.0 = incomplete, 1.0 = fully complete)"
    },
    "constraints_applied": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["full", "summary", "section", "incremental"],
          "description": "Scope of documentation generation"
        },
        "timeframe": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time",
              "description": "Start of timeframe for source events"
            },
            "to": {
              "type": "string",
              "format": "date-time",
              "description": "End of timeframe for source events"
            }
          },
          "additionalProperties": false
        },
        "artifact_type": {
          "type": "string",
          "description": "Requested artifact type constraint"
        },
        "audience": {
          "type": "string",
          "enum": ["executive", "technical", "compliance", "investor", "auditor", "board"],
          "description": "Target audience for the documentation"
        },
        "classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"],
          "description": "Classification level of the documentation"
        }
      },
      "required": ["scope", "artifact_type", "audience"],
      "additionalProperties": false
    },
    "execution_ref": {
      "type": "string",
      "format": "uuid",
      "description": "Unique reference for this execution"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of event emission (ISO 8601)"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Optional correlation ID for tracing related events"
    },
    "source_system": {
      "type": "string",
      "const": "agentics-diligence-artifacts",
      "description": "Fixed source system identifier"
    }
  },
  "required": [
    "agent_id",
    "agent_version",
    "decision_type",
    "inputs_hash",
    "outputs",
    "confidence",
    "constraints_applied",
    "execution_ref",
    "timestamp",
    "source_system"
  ],
  "additionalProperties": false
}
