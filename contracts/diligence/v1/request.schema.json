{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.io/contracts/diligence/v1/request.schema.json",
  "title": "Diligence API Request",
  "description": "Schema for validating incoming requests to the Agentics Diligence API",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD"]
    },
    "path": {
      "type": "string",
      "pattern": "^/v1/diligence/?$|^/v1/diligence/(architecture|benchmarks|narratives|valuation)$|^/health$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json"]
        }
      }
    },
    "headers": {
      "type": "object",
      "properties": {
        "content-type": {
          "type": "string"
        },
        "accept": {
          "type": "string"
        }
      }
    },
    "body": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "refs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "type": { "type": "string", "enum": ["simulation", "plan", "report", "assessment"] }
                },
                "required": ["id", "type"],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "frameworks": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "include_evidence": { "type": "boolean" },
            "certifying_authority": { "type": "string" },
            "execution_context": { "type": "object" }
          },
          "required": ["refs", "frameworks"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "frameworks": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "format": {
              "type": "string",
              "enum": ["json"]
            },
            "include_evidence": { "type": "boolean" },
            "certifying_authority": { "type": "string" },
            "execution_context": { "type": "object" }
          },
          "required": ["description", "frameworks"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["method", "path"],
  "additionalProperties": false
}
